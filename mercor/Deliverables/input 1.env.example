# ==============================================================================
# Input 1: Starting Baseline Environment Configuration (.env.example)
# Unconfigured template prior to cloud database provisioning.
# ==============================================================================

APP_NAME="Resume Project Review Platform"
APP_ENV=development
DEBUG=true

# Database & Cache (To be provisioned during task)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH=development
REDIS_URL=""

# Storage
STORAGE_DIR=/tmp/resume_storage

# Authentication & Sessions
SECRET_KEY=dev-insecure-secret-key-change-in-prod
ADMIN_PASSWORD=change-this-admin-password
SESSION_TTL_SECONDS=86400
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# CORS & Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
